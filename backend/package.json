    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.13.4",
    "tsx": "4.19.3",
    "typescript": "5.7.3"
  }
}

